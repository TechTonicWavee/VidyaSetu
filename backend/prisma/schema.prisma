// MIRROR of frontend/prisma/schema.prisma — that file is the canonical
// source of truth and owns all migrations. This copy exists only so the
// backend package can `prisma generate` its own client against the same
// DB. Run migrations from frontend/, then re-copy this file and
// `npm run prisma:generate` here after any schema change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Student {
  id               String    @id @default(uuid())
  universityId     String    @unique
  fullName         String
  dob              DateTime?
  branch           String?
  year             Int?
  section          String?
  email            String?
  phone            String?
  password         String?
  isFirstLogin     Boolean   @default(true)
  formStatus       String    @default("not_registered")
  formProgress     Json?
  formSubmittedAt  DateTime?
  resumeUrl        String?
  resumeParsed     Json?
  resumeAnalyzedAt DateTime?
  resumePublicId   String?
  avatarUrl        String?
  avatarPublicId   String?
  domain           String?
  spiScore         Float?    @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  codingProfile    CodingProfile?
  projects         Project[]
  certifications   Certification[]
  hackathons       Hackathon[]
  extracurriculars Extracurricular[]
  internships      Internship[]

  teamsLed        Team[]         @relation("TeamLeader")
  teamMemberships TeamMember[]
  invitesSent     TeamInvite[]   @relation("InviteSender")
  invitesReceived TeamInvite[]   @relation("InviteReceiver")
  notifications   Notification[]
  refreshTokens   RefreshToken[]

  @@map("students")
}

model CodingProfile {
  id             String    @id @default(uuid())
  universityId   String    @unique
  github         String?
  leetcode       String?
  codechef       String?
  hackerrank     String?
  codeforces     String?
  gfg            String?
  linkedinUrl    String?
  githubRepos    Int?
  leetcodeSolved Int?
  codechefRating Int?
  lastFetched    DateTime?
  githubStats    Json?
  leetcodeStats  Json?

  student Student @relation(fields: [universityId], references: [universityId])

  @@map("coding_profiles")
}

model Project {
  id                 String   @id @default(uuid())
  universityId       String
  title              String
  description        String?
  techStack          String[]
  type               String?
  teamSize           String?
  githubLink         String?
  liveLink           String?
  screenshotUrl      String?
  screenshotPublicId String?
  status             String?
  role               String?
  createdAt          DateTime @default(now())

  student Student @relation(fields: [universityId], references: [universityId])

  @@map("projects")
}

model Certification {
  id                  String    @id @default(uuid())
  universityId        String
  name                String
  platform            String?
  completionDate      DateTime?
  certificateUrl      String?
  certificatePublicId String?
  skills              String[]
  createdAt           DateTime  @default(now())

  student Student @relation(fields: [universityId], references: [universityId])

  @@map("certifications")
}

model Hackathon {
  id               String    @id @default(uuid())
  universityId     String
  name             String
  organizer        String?
  date             DateTime?
  teamSize         Int?
  position         String?
  problemStatement String?
  solution         String?
  createdAt        DateTime  @default(now())

  student Student @relation(fields: [universityId], references: [universityId])

  @@map("hackathons")
}

model Extracurricular {
  id           String  @id @default(uuid())
  universityId String
  society      String?
  role         String?
  year         String?
  achievement  String?

  student Student @relation(fields: [universityId], references: [universityId])

  @@map("extracurriculars")
}

model Internship {
  id             String    @id @default(uuid())
  universityId   String
  company        String?
  role           String?
  startDate      DateTime?
  endDate        DateTime?
  techStack      String[]
  description    String?
  offerLetterUrl String?

  student Student @relation(fields: [universityId], references: [universityId])

  @@map("internships")
}

// --- Krrish's modules: My Team / Domain Directory / Notifications / Auth ---

model Team {
  id          String   @id @default(uuid())
  name        String
  description String?
  domain      String?
  leaderId    String
  maxMembers  Int      @default(4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leader  Student      @relation("TeamLeader", fields: [leaderId], references: [universityId])
  members TeamMember[]
  invites TeamInvite[]

  @@index([leaderId])
  @@map("teams")
}

model TeamMember {
  id           String   @id @default(uuid())
  teamId       String
  universityId String
  role         String   @default("member")
  joinedAt     DateTime @default(now())

  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [universityId], references: [universityId])

  @@unique([teamId, universityId])
  @@index([universityId])
  @@map("team_members")
}

model TeamInvite {
  id          String    @id @default(uuid())
  teamId      String
  senderId    String
  receiverId  String
  message     String?
  status      String    @default("pending")
  // 'invite'       — a leader/member invites a student (receiver = invited student)
  // 'join_request' — a student requests to join (sender = requesting student, receiver = team leader)
  type        String    @default("invite")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  team     Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sender   Student @relation("InviteSender", fields: [senderId], references: [universityId])
  receiver Student @relation("InviteReceiver", fields: [receiverId], references: [universityId])

  @@index([teamId])
  @@index([senderId])
  @@index([receiverId])
  @@map("team_invites")
}

model Notification {
  id           String   @id @default(uuid())
  universityId String
  type         String
  title        String
  body         String?
  payload      Json?
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())

  student Student @relation(fields: [universityId], references: [universityId])

  @@index([universityId, read])
  @@map("notifications")
}

model RefreshToken {
  id           String   @id @default(uuid())
  universityId String
  tokenHash    String   @unique
  revoked      Boolean  @default(false)
  replacedBy   String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  student Student @relation(fields: [universityId], references: [universityId])

  @@index([universityId])
  @@map("refresh_tokens")
}
