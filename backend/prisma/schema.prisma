generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Student {
  id                   String                @id @default(uuid())
  universityId         String                @unique
  fullName             String
  dob                  DateTime?
  branch               String?
  year                 Int?
  section              String?
  email                String?
  phone                String?
  fatherPhone          String?
  gender               String?
  password             String?
  isFirstLogin         Boolean               @default(true)
  formStatus           String                @default("not_registered")
  formProgress         Json?
  formSubmittedAt      DateTime?
  resumeUrl            String?
  spiScore             Float?                @default(0)
  spiHistory           Json?                 @default("[]")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  admissionYear        Int?
  avatarPublicId       String?
  avatarUrl            String?
  domain               String?
  resumeAnalyzedAt     DateTime?
  resumeParsed         Json?
  resumePublicId       String?
  cgpa                 Float?                @default(0)
  attendance           Float?
  classesAttended      Int?
  classesTotal         Int?
  semester             Int?
  certifications       Certification[]
  codingProfile        CodingProfile?
  extracurriculars     Extracurricular[]
  hackathons           Hackathon[]
  internships          Internship[]
  notifications        Notification[]
  projects             Project[]
  refreshTokens        RefreshToken[]
  invitesReceived      TeamInvite[]          @relation("InviteReceiver")
  invitesSent          TeamInvite[]          @relation("InviteSender")
  teamMemberships      TeamMember[]
  teamsLed             Team[]                @relation("TeamLeader")
  teammatePosts        TeammatePost[]
  teammateApplications TeammateApplication[]
  projectRoles         TeamProjectRole[]
  projectTasks         TeamProjectTask[]
  ProfileSectionEmbedding       ProfileSectionEmbedding[]
  StudentSummary                StudentSummary[]
  ResumeRequest                 ResumeRequest[]
  ResumeClarificationPreference ResumeClarificationPreference[]

  mentorId         String?
  mentor           Faculty?          @relation("FacultyMentees", fields: [mentorId], references: [facultyId])
  sectionId        String?
  sectionRelation  Section?          @relation("SectionStudents", fields: [sectionId], references: [id])
  behavioralNotes  BehavioralNote[]
  alerts           Alert[]

  @@map("students")
}

model CodingProfile {
  id             String    @id @default(uuid())
  universityId   String    @unique
  github         String?
  leetcode       String?
  codechef       String?
  hackerrank     String?
  codeforces     String?
  gfg            String?
  linkedinUrl    String?
  githubRepos    Int?
  leetcodeSolved Int?
  codechefRating Int?
  lastFetched    DateTime?
  githubStats    Json?
  leetcodeStats  Json?
  student        Student   @relation(fields: [universityId], references: [universityId])

  @@map("coding_profiles")
}

model Project {
  id                 String   @id @default(uuid())
  universityId       String
  title              String
  description        String?
  techStack          String[]
  type               String?
  teamSize           String?
  githubLink         String?
  liveLink           String?
  status             String?
  role               String?
  createdAt          DateTime @default(now())
  screenshotPublicId String?
  screenshotUrl      String?
  student            Student  @relation(fields: [universityId], references: [universityId])

  @@map("projects")
}

model Certification {
  id                  String    @id @default(uuid())
  universityId        String
  name                String
  platform            String?
  completionDate      DateTime?
  certificateUrl      String?
  skills              String[]
  createdAt           DateTime  @default(now())
  certificatePublicId String?
  breakdown           Json?
  credentialId        String?
  score               Float?
  tier                String?
  verificationUrl     String?
  isFromResume        Boolean   @default(false)
  recipientName       String?
  student             Student   @relation(fields: [universityId], references: [universityId])

  @@map("certifications")
}

model Hackathon {
  id               String    @id @default(uuid())
  universityId     String
  name             String
  organizer        String?
  date             DateTime?
  teamSize         Int?
  position         String?
  problemStatement String?
  solution         String?
  createdAt        DateTime  @default(now())
  student          Student   @relation(fields: [universityId], references: [universityId])

  @@map("hackathons")
}

model Extracurricular {
  id           String  @id @default(uuid())
  universityId String
  society      String?
  role         String?
  year         String?
  achievement  String?
  student      Student @relation(fields: [universityId], references: [universityId])

  @@map("extracurriculars")
}

model Internship {
  id                       String    @id @default(uuid())
  universityId             String
  company                  String?
  role                     String?
  startDate                DateTime?
  endDate                  DateTime?
  techStack                String[]
  description              String?
  offerLetterUrl           String?
  completionCertificateUrl String?
  isPaid                   Boolean   @default(false)
  recipientName            String?
  stipendAmount            Float?    @default(0)
  student                  Student   @relation(fields: [universityId], references: [universityId])

  @@map("internships")
}

model Team {
  id          String       @id @default(uuid())
  name        String
  description String?
  domain      String?
  leaderId    String
  maxMembers  Int          @default(4)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  invites     TeamInvite[]
  members     TeamMember[]
  leader      Student      @relation("TeamLeader", fields: [leaderId], references: [universityId])
  project     TeamProject?

  @@index([leaderId])
  @@map("teams")
}

model TeamMember {
  id           String   @id @default(uuid())
  teamId       String
  universityId String
  role         String   @default("member")
  joinedAt     DateTime @default(now())
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  student      Student  @relation(fields: [universityId], references: [universityId])

  @@unique([teamId, universityId])
  @@index([universityId])
  @@map("team_members")
}

model TeamInvite {
  id          String    @id @default(uuid())
  teamId      String
  senderId    String
  receiverId  String
  message     String?
  status      String    @default("pending")
  type        String    @default("invite")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?
  receiver    Student   @relation("InviteReceiver", fields: [receiverId], references: [universityId])
  sender      Student   @relation("InviteSender", fields: [senderId], references: [universityId])
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([senderId])
  @@index([receiverId])
  @@map("team_invites")
}

model Notification {
  id           String   @id @default(uuid())
  universityId String
  type         String
  title        String
  body         String?
  payload      Json?
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())
  student      Student  @relation(fields: [universityId], references: [universityId])

  @@index([universityId, read])
  @@map("notifications")
}

model RefreshToken {
  id           String   @id @default(uuid())
  universityId String
  tokenHash    String   @unique
  revoked      Boolean  @default(false)
  replacedBy   String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  student      Student  @relation(fields: [universityId], references: [universityId])

  @@index([universityId])
  @@map("refresh_tokens")
}

// ── "Looking for Teammates" marketplace ─────────────────────────────────────
// A student posts an open requirement (role, event, headcount, tech stack);
// other students apply; the poster reviews applicants' public profile
// (GitHub/LinkedIn/skills) and accepts or rejects — both notify the applicant.
model TeammatePost {
  id            String                @id @default(uuid())
  postedBy      String
  eventName     String
  role          String
  membersNeeded Int
  description   String?
  techStack     String[]
  status        String                @default("open") // open | closed
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  poster        Student               @relation(fields: [postedBy], references: [universityId])
  applications  TeammateApplication[]

  @@index([postedBy])
  @@index([status])
  @@map("teammate_posts")
}

model TeammateApplication {
  id          String       @id @default(uuid())
  postId      String
  applicantId String
  status      String       @default("pending") // pending | accepted | rejected
  message     String?
  createdAt   DateTime     @default(now())
  respondedAt DateTime?
  post        TeammatePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  applicant   Student      @relation(fields: [applicantId], references: [universityId])

  @@unique([postId, applicantId])
  @@index([applicantId])
  @@map("teammate_applications")
}

// ── Project Tracker ──────────────────────────────────────────────────────────
// One project per team. The leader defines ordered phases (each with a
// mentor name and mandatory GitHub link), marks phase progress, assigns
// tasks to members, and — once every phase is complete plus a deployed
// link is supplied — the project awaits mentor approval. The "faculty side"
// of this (remarks, approval) isn't gated behind real faculty accounts: the
// faculty portal has no auth system of its own yet, so a mentor identifies
// themselves by the same name recorded on the phase they're monitoring.
model TeamProject {
  id           String              @id @default(uuid())
  teamId       String              @unique
  name         String
  mentorName   String
  githubLink   String
  status       String              @default("in_progress") // in_progress | pending_approval | approved | rejected
  deployedLink String?
  createdBy    String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  team         Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  phases       TeamProjectPhase[]
  roles        TeamProjectRole[]
  tasks        TeamProjectTask[]
  remarks      TeamProjectRemark[]

  @@map("team_projects")
}

model TeamProjectPhase {
  id           String      @id @default(uuid())
  projectId    String
  name         String
  order        Int
  memberIds    String[]    @default([])
  deployedLink String?
  status       String      @default("pending") // pending | in_progress | completed
  completedAt  DateTime?
  createdAt    DateTime    @default(now())
  project      TeamProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("team_project_phases")
}

model TeamProjectRole {
  id           String      @id @default(uuid())
  projectId    String
  universityId String
  role         String?
  work         String?
  project      TeamProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  student      Student     @relation(fields: [universityId], references: [universityId])

  @@unique([projectId, universityId])
  @@map("team_project_roles")
}

model TeamProjectTask {
  id          String      @id @default(uuid())
  projectId   String
  assignedTo  String
  title       String
  description String?
  status      String      @default("not_done") // not_done | done
  statusNote  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  project     TeamProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    Student     @relation(fields: [assignedTo], references: [universityId])

  @@index([projectId])
  @@index([assignedTo])
  @@map("team_project_tasks")
}

model TeamProjectRemark {
  id         String      @id @default(uuid())
  projectId  String
  authorName String
  message    String
  createdAt  DateTime    @default(now())
  project    TeamProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("team_project_remarks")
}

model Faculty {
  id             String    @id @default(uuid())
  facultyId      String    @unique
  fullName       String
  email          String    @unique
  department     String
  avatarUrl      String?
  password       String?
  
  mentees        Student[] @relation("FacultyMentees")
  sections       Section[] @relation("FacultySections")
  notesGiven     BehavioralNote[]
  alertsGiven    Alert[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("faculty")
}

model Subject {
  id          String    @id @default(uuid())
  name        String
  code        String?
  sections    Section[]
  
  createdAt   DateTime  @default(now())

  @@map("subjects")
}

model Section {
  id          String    @id @default(uuid())
  name        String
  year        String?
  department  String?
  
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id])
  
  facultyId   String
  faculty     Faculty   @relation("FacultySections", fields: [facultyId], references: [facultyId])
  
  students    Student[] @relation("SectionStudents")
  
  createdAt   DateTime  @default(now())

  @@map("sections")
}

model BehavioralNote {
  id          String   @id @default(uuid())
  studentId   String
  facultyId   String
  content     String
  visibility  String   @default("Private")
  createdAt   DateTime @default(now())
  
  student     Student  @relation(fields: [studentId], references: [universityId], onDelete: Cascade)
  faculty     Faculty  @relation(fields: [facultyId], references: [facultyId], onDelete: Cascade)

  @@index([studentId])
  @@index([facultyId])
  @@map("behavioral_notes")
}

model Alert {
  id          String   @id @default(uuid())
  studentId   String
  facultyId   String
  type        String
  severity    String   @default("Low")
  comment     String?
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  
  student     Student  @relation(fields: [studentId], references: [universityId], onDelete: Cascade)
  faculty     Faculty  @relation(fields: [facultyId], references: [facultyId], onDelete: Cascade)

  @@index([studentId])
  @@index([facultyId])
  @@map("alerts")
}

model ProfileSectionEmbedding {
  id           String                      @id @default(uuid())
  universityId String
  student      Student                     @relation(fields: [universityId], references: [universityId])
  sectionType  String
  sourceId     String
  content      String
  embedding    Unsupported("vector(2048)")
  updatedAt    DateTime                    @updatedAt

  @@map("profile_section_embeddings")
}

model StudentSummary {
  universityId String   @id
  student      Student  @relation(fields: [universityId], references: [universityId])
  summaryJson  Json
  updatedAt    DateTime @updatedAt

  @@map("student_summaries")
}

model ResumeRequest {
  id                    String          @id @default(uuid())
  universityId          String
  student               Student         @relation(fields: [universityId], references: [universityId])
  jdText                String
  jdHash                String
  extractedRequirements Json?
  clarificationAnswers  Json?
  status                String          @default("pending_extraction")
  createdAt             DateTime        @default(now())
  versions              ResumeVersion[]

  @@map("resume_requests")
}

model ResumeVersion {
  id              String        @id @default(uuid())
  resumeRequestId String
  resumeRequest   ResumeRequest @relation(fields: [resumeRequestId], references: [id])
  resumeJson      Json
  createdAt       DateTime      @default(now())

  @@map("resume_versions")
}

model ResumeClarificationPreference {
  id              String   @id @default(uuid())
  universityId    String
  student         Student  @relation(fields: [universityId], references: [universityId])
  preferenceKey   String
  preferenceValue String
  createdAt       DateTime @default(now())

  @@map("resume_clarification_preferences")
}
