# Supabase Postgres (same DB the backend/ package connects to)
DATABASE_URL=
DIRECT_URL=

# Only used by frontend/lib/supabase.js
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Standalone backend (Team / Directory / Notifications / Auth) — see /backend
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Must match backend/.env's JWT_ACCESS_SECRET exactly — both verify the same tokens.
JWT_ACCESS_SECRET=

# Cloudinary (Profile uploads: avatar, resume, project screenshots, certificates)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))" for secrets you own,
# but these three come from your Cloudinary account dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Raises GitHub API rate limits when fetching a student's public GitHub stats
GITHUB_TOKEN=
